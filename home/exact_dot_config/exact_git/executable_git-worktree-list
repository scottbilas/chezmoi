#!/usr/bin/env bash
# shellcheck disable=SC1091

set -e

# shellcheck disable=SC2034
USAGE=''
# shellcheck disable=SC2034
SUBDIRECTORY_OK=Yes
. git-sh-setup

[ "$DEBUG" ] && set -x

CYAN='\033[36m'
YELLOW='\033[33m'
ORANGE='\033[38;5;208m'
RED='\033[31m'
GREEN='\033[32m'
DIM='\033[2m'
ITALIC='\033[3m'
UNDERLINE='\033[4m'
RESET='\033[0m'

main() {
    declare -a paths refs infos memos
    max_path_len=0
    max_ref_len=0

    local current_wt
    current_wt=$(cd "$(git rev-parse --show-toplevel)" && pwd -P)

    while IFS= read -r line; do
        path=$(echo "$line" | awk '{print $1}')
        sha=$(echo "$line" | awk '{print $2}')
        
        if [[ "$line" =~ \(detached\ HEAD\) ]]; then
            ref="detached at $sha"
            info=""
        elif [[ "$sha" == "0000000000" ]]; then
            ref="bare"
            info=""
        elif [[ "$line" =~ \[([^]]+)\] ]]; then
            branch="${BASH_REMATCH[1]}"
            ref="$branch"
            info=$(get_upstream_info "$path" "$branch")
        else
            ref="detached at $sha"
            info=""
        fi

        local memo=""
        if [[ -n "$branch" ]]; then
            memo=$(git config "branch.$branch.memo" 2>/dev/null || true)
        fi

        paths+=("$path")
        refs+=("$ref")
        infos+=("$info")
        memos+=("$memo")

        (( ${#path} > max_path_len )) && max_path_len=${#path}
        (( ${#ref} > max_ref_len )) && max_ref_len=${#ref}
    done < <(git worktree list)

    for i in "${!paths[@]}"; do
        path="${paths[$i]}"
        ref="${refs[$i]}"
        info="${infos[$i]}"
        memo="${memos[$i]}"

        padded_ref=$(printf "%-${max_ref_len}s" "$ref")
        padding="${padded_ref:${#ref}}"

        local real_path
        real_path=$(cd "$path" 2>/dev/null && pwd -P || echo "$path")
        if [[ "$real_path" == "$current_wt" ]]; then
            marker="*"
            ul="${UNDERLINE}"
        else
            marker=" "
            ul=""
        fi

        if [[ "$ref" =~ ^detached\ at|^bare ]]; then
            colored_ref="${ul}${DIM}${ITALIC}${ref}${RESET}${padding}"
        elif [[ -n "$info" ]]; then
            colored_ref="${ul}${CYAN}${ref}${RESET}${padding}"
        else
            colored_ref="${ul}${ref}${RESET}${padding}"
        fi

        local memo_col=""
        if [[ -n "$memo" ]]; then
            memo_col="  ${YELLOW}${ITALIC}${memo}${RESET}"
        fi

        if [[ -z "$info" ]]; then
            printf "%-${max_path_len}s %s %b%b\n" "$path" "$marker" "$colored_ref" "$memo_col"
        elif [[ "$info" == "gone" ]]; then
            printf "%-${max_path_len}s %s %b  %b%b\n" "$path" "$marker" "$colored_ref" "${RED}${info}${RESET}" "$memo_col"
        elif [[ "$info" =~ ahead && "$info" =~ behind ]]; then
            printf "%-${max_path_len}s %s %b  %b%b\n" "$path" "$marker" "$colored_ref" "${ORANGE}${info}${RESET}" "$memo_col"
        elif [[ "$info" =~ behind ]]; then
            printf "%-${max_path_len}s %s %b  %b%b\n" "$path" "$marker" "$colored_ref" "${YELLOW}${info}${RESET}" "$memo_col"
        else
            printf "%-${max_path_len}s %s %b  %b%b\n" "$path" "$marker" "$colored_ref" "${GREEN}${info}${RESET}" "$memo_col"
        fi
    done
}

get_upstream_info() {
    local wt_path="$1"
    local branch="$2"

    local upstream
    upstream=$(git -C "$wt_path" for-each-ref --format='%(upstream:short)' "refs/heads/$branch" 2>/dev/null)

    if [[ -z "$upstream" ]]; then
        echo ""
        return
    fi

    if ! git -C "$wt_path" rev-parse --verify "$upstream" &>/dev/null; then
        echo "gone"
        return
    fi

    local counts
    counts=$(git -C "$wt_path" rev-list --left-right --count "$branch...$upstream" 2>/dev/null)
    
    if [[ -z "$counts" ]]; then
        echo ""
        return
    fi

    local ahead behind
    ahead=$(echo "$counts" | awk '{print $1}')
    behind=$(echo "$counts" | awk '{print $2}')

    if [[ "$ahead" -eq 0 && "$behind" -eq 0 ]]; then
        echo "in sync"
    elif [[ "$ahead" -gt 0 && "$behind" -gt 0 ]]; then
        echo "ahead $ahead; behind $behind"
    elif [[ "$ahead" -gt 0 ]]; then
        echo "ahead $ahead"
    else
        echo "behind $behind"
    fi
}

main "$@"
