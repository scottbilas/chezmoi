#!/usr/bin/env bash
# shellcheck disable=SC1091

set -e

# shellcheck disable=SC2034
USAGE='[-a|--all]'
# shellcheck disable=SC2034
SUBDIRECTORY_OK=Yes
. git-sh-setup

[ "$DEBUG" ] && set -x

CYAN='\033[36m'
YELLOW='\033[33m'
ORANGE='\033[95m'
RED='\033[31m'
GREEN='\033[32m'
DIM='\033[2m'
ITALIC='\033[3m'
UNDERLINE='\033[4m'
RESET='\033[0m'

main() {
    local show_all=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -a|--all) show_all=true; shift ;;
            *) usage ;;
        esac
    done

    declare -a branches shas upstreams upstream_displays worktrees infos memos is_remotes
    max_branch_len=0
    max_wt_len=0
    max_upstream_len=0

    # get current branch
    local current_branch
    current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)

    # build worktree lookup: branch -> worktree path
    declare -A wt_map
    while IFS= read -r line; do
        local wt_branch
        read -r wt_path _ <<< "$line"

        if [[ "$line" =~ \[([^]]+)\] ]]; then
            wt_branch="${BASH_REMATCH[1]}"
            wt_map["$wt_branch"]="$wt_path"
        fi
    done < <(git worktree list)

    # batch: get all branch memos in one call
    declare -A memo_map
    while IFS= read -r line; do
        # line format: "branch.BRANCHNAME.memo VALUE"
        local key="${line#branch.}"
        local value="${key##*.memo }"
        key="${key%.memo *}"
        memo_map["$key"]="$value"
    done < <(git config --get-regexp '^branch\..*\.memo$' 2>/dev/null)

    # track which remote refs are already covered by a local branch's upstream
    declare -A tracked_remotes

    # iterate all local branches (get branch, sha, upstream, and tracking info in one pass)
    while IFS=$'\t' read -r branch sha upstream track; do
        local wt_path="${wt_map[$branch]:-}"

        # convert tracking info from for-each-ref format
        local info=""
        if [[ -n "$upstream" ]]; then
            tracked_remotes["$upstream"]=1
            if [[ -z "$track" ]]; then
                info="in sync"
            elif [[ "$track" == "gone" ]]; then
                info="gone"
            else
                # convert "ahead N, behind M" to "ahead N; behind M"
                info="${track//, /; }"
            fi
        fi

        local memo="${memo_map[$branch]:-}"

        # format upstream display name
        local upstream_display=""
        if [[ -n "$upstream" ]]; then
            if [[ "$upstream" == "origin/$branch" ]]; then
                upstream_display="origin/*"
            else
                upstream_display="$upstream"
            fi
        fi

        branches+=("$branch")
        shas+=("$sha")
        upstreams+=("$upstream")
        upstream_displays+=("$upstream_display")
        worktrees+=("$wt_path")
        infos+=("$info")
        memos+=("$memo")
        is_remotes+=(false)

        (( ${#branch} > max_branch_len )) && max_branch_len=${#branch}
        (( ${#wt_path} > max_wt_len )) && max_wt_len=${#wt_path}
        (( ${#upstream_display} > max_upstream_len )) && max_upstream_len=${#upstream_display}
    done < <(git for-each-ref --format='%(refname:short)%09%(objectname:short)%09%(upstream:short)%09%(upstream:track,nobracket)' --sort='refname:short' refs/heads/)

    # add remote-tracking branches not already tracked by a local branch
    if [[ "$show_all" == true ]]; then
        while IFS=$'\t' read -r rbranch sha; do
            # skip the remote HEAD pointer (e.g. origin/HEAD) and bare remote refs (e.g. origin)
            [[ "$rbranch" == */HEAD || "$rbranch" != */* ]] && continue
            # skip remotes already tracked by a local branch
            [[ -n "${tracked_remotes[$rbranch]:-}" ]] && continue

            branches+=("")
            shas+=("$sha")
            upstreams+=("")
            upstream_displays+=("$rbranch")
            worktrees+=("")
            infos+=("")
            memos+=("")
            is_remotes+=(true)

            (( ${#rbranch} > max_upstream_len )) && max_upstream_len=${#rbranch}
        done < <(git for-each-ref --format='%(refname:short)%09%(objectname:short)' --sort='refname:short' refs/remotes/)
    fi

    for i in "${!branches[@]}"; do
        local branch="${branches[$i]}"
        local sha="${shas[$i]}"
        local upstream_display="${upstream_displays[$i]}"
        local wt_path="${worktrees[$i]}"
        local info="${infos[$i]}"
        local memo="${memos[$i]}"

        local padded_branch
        padded_branch=$(printf "%-${max_branch_len}s" "$branch")
        local padding="${padded_branch:${#branch}}"

        # current branch marker
        local marker=" "
        local ul=""
        if [[ "$branch" == "$current_branch" ]]; then
            marker="*"
            ul="${UNDERLINE}"
        fi

        # color the branch name
        local colored_branch
        if [[ "${is_remotes[$i]}" == true ]]; then
            colored_branch="${padding}"
        elif [[ -n "${upstreams[$i]}" ]]; then
            colored_branch="${ul}${CYAN}${branch}${RESET}${padding}"
        else
            colored_branch="${ul}${branch}${RESET}${padding}"
        fi

        # sha column
        local sha_col="${DIM}${sha}${RESET}"

        # upstream column (with padding for alignment)
        local padded_upstream
        padded_upstream=$(printf "%-${max_upstream_len}s" "$upstream_display")
        local upstream_padding="${padded_upstream:${#upstream_display}}"
        local colored_upstream
        if [[ -z "$upstream_display" ]]; then
            colored_upstream="${upstream_padding}"
        elif [[ "${is_remotes[$i]}" == true ]]; then
            colored_upstream="${DIM}${upstream_display}${RESET}${upstream_padding}"
        elif [[ "$upstream_display" == "origin/*" ]]; then
            colored_upstream="${DIM}${ITALIC}${upstream_display}${RESET}${upstream_padding}"
        else
            colored_upstream="${YELLOW}${upstream_display}${RESET}${upstream_padding}"
        fi

        # worktree column
        local wt_col
        wt_col=$(printf "%-${max_wt_len}s" "$wt_path")

        # info column
        local info_col=""
        if [[ -n "$info" ]]; then
            if [[ "$info" == "gone" ]]; then
                info_col="  ${RED}${info}${RESET}"
            elif [[ "$info" =~ ahead && "$info" =~ behind ]]; then
                info_col="  ${ORANGE}${info}${RESET}"
            elif [[ "$info" =~ behind ]]; then
                info_col="  ${YELLOW}${info}${RESET}"
            else
                info_col="  ${GREEN}${info}${RESET}"
            fi
        fi

        # memo column
        local memo_col=""
        if [[ -n "$memo" ]]; then
            memo_col="  ${YELLOW}${ITALIC}${memo}${RESET}"
        fi

        printf "%s %b %b  %b  ${DIM}%-${max_wt_len}s${RESET}%b%b\n" \
            "$marker" "$colored_branch" "$sha_col" "$colored_upstream" "$wt_path" "$info_col" "$memo_col"
    done
}

main "$@"
