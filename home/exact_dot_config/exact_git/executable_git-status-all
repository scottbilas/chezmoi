#!/usr/bin/env bash
# shellcheck disable=SC1091

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- worker: invoked directly by xargs (not through git) ---
if [[ "${1:-}" == "--worker" ]]; then
    [ "$DEBUG" ] && set -x

    YELLOW='\033[93m'
    RESET='\033[0m'

    actual_dir="$2"
    OUTDIR="$3"

    resolved_parent="$(dirname "$(pwd -P)")"
    unresolved_parent="$(dirname "$PWD" | sed "s|^$HOME|~|")"

    display_dir="${actual_dir/#$resolved_parent/$unresolved_parent}"
    outfile="$OUTDIR/$(basename "$actual_dir")"

    {
      echo -e "${YELLOW}========== $display_dir ==========${RESET}"
      git -C "$actual_dir" status-nice
    } >"$outfile"

    printf "%s " "$(basename "$actual_dir")" >&2
    exit 0
fi

# shellcheck disable=SC2034
USAGE=''
# shellcheck disable=SC2034
SUBDIRECTORY_OK=Yes
. git-sh-setup

[ "$DEBUG" ] && set -x

# shellcheck source=lib/parallel-worktrees.sh
. "$SCRIPT_DIR/lib/parallel-worktrees.sh"

main () {

set -euo pipefail

ITALIC='\033[3m'
CYAN='\033[96m'
RESET='\033[0m'

local ncpus
ncpus=$(pwt_ncpus)
echo -n -e "${ITALIC}Gathering status from worktrees (max $ncpus jobs)... ${CYAN}" >&2

pwt_run "$SCRIPT_DIR/git-status-all" --worker

echo -e "...done!${RESET}" >&2
echo >&2

pwt_cat_results $'\n'
pwt_cleanup

}

main "$@"
