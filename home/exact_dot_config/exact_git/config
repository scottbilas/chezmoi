### COMMON ###

[diff]
    algorithm = histogram
    color-moved = default
    mnemonicprefix = true
    renames = copies
    renameLimit = 50000
    external = difft

[difftool "difftastic"]
    cmd = difft --color always "$MERGED" "$LOCAL" "abcdef1" "100644" "$REMOTE" "abcdef2" "100644"

[pager]
    difftool = true

[interactive]
    diffFilter = delta --color-only --features=interactive

[merge]
    renamelimit = 50000
    stat = true
    conflictStyle = diff3


