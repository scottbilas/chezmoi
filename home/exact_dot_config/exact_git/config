[filter "lfs"]
    clean = git-lfs clean -- %f
    process = git-lfs filter-process
    smudge = git-lfs smudge -- %f
    required = true

# use diff/merge type lfs-text in .gitattributes to enable text diff/merge of LFS files
[diff "lfs-text"]
    textconv = cat
[merge "lfs-text"]
    driver = git lfs merge-driver --ancestor %O --current %A --other %B --marker-size %L --output %A

# in my testing on a couple workstations, this got up to 25% faster clone time on unity monorepo. default concurrency is 3 or 8.
[lfs]
    concurrenttransfers = 24


