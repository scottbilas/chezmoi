source ~/.config/zsh/zaliases

# finally any modules

# zsh-autosuggestions forks a child process on every keystroke in async mode (enabled by default
# for zsh >= 5.0.8). The `completion` strategy adds a second fork via zpty. In VS Code terminals,
# SIGCHLD from these children can race with ZLE's event loop in node-pty, causing the shell to
# freeze until SIGWINCH (window resize) interrupts it. Disable async and drop `completion` there.
if [[ -n "$VSCODE_SHELL_INTEGRATION" ]]; then
  export ZSH_AUTOSUGGEST_STRATEGY=(history)
else
  export ZSH_AUTOSUGGEST_STRATEGY=(history completion)
fi
export ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20
bindkey '^ ' autosuggest-accept

if (( $+commands[sheldon] )); then
  eval "$(sheldon source)"

  # must unset AFTER sheldon loads zsh-autosuggestions (via zsh-defer), because the plugin
  # unconditionally sets ZSH_AUTOSUGGEST_USE_ASYNC at load time. zsh-defer runs the deferred
  # source synchronously before the next prompt, so schedule our unset to run after it.
  if [[ -n "$VSCODE_SHELL_INTEGRATION" ]]; then
    zsh-defer -c 'unset ZSH_AUTOSUGGEST_USE_ASYNC'
  fi

  # set fast-syntax-highlighter theme if one not already set
  [[ ! -f ~/.cache/fsh/current_theme.zsh ]] && zsh-defer fast-theme -q free

  # set shell theme if not set
  # TODO: doesn't work..base16_* are generated aliases and even a manual `setopt aliases` (on by default) gives a command not found error.
  #[[ ! -f ~/.base16_theme ]] && base16_twilight

  [[ -f ~/.base16_theme ]] && . ~/.base16_theme
fi

