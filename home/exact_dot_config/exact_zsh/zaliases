# use 'Q' hotkey to exit ranger and keep its CWD
# (https://superuser.com/a/1436077/4518)
function ranger {
  local IFS=$'\t\n'
  local tempfile
  tempfile="$(mktemp -t tmp.XXXXXX)"
  local -a ranger_cmd=(
    command
    ranger
    --cmd="map Q chain shell echo %d > \"$tempfile\"; quitall"
  )

  "${ranger_cmd[@]}" "$@"

  if [[ -f "$tempfile" ]]; then
    local newdir; newdir="$(<"$tempfile")"
    [[ "$newdir" != "$PWD" ]] && cd -- "$newdir" || return
  fi

  command rm -f -- "$tempfile" 2>/dev/null
}
alias r=ranger

get-api-key() {
  local key=$1
  if [[ -z $key ]]; then
    print -u2 "usage: get-api-key <keyname>"
    return 2
  fi

  file="$(chezmoi execute-template '{{ .profile.keyfile }}')"
  yq -p toml -o=yaml '.["API Keys"]["'"$key"'"]' "$file"
}

git-raw() {
  local -a kvs=(
    GIT_CONFIG_GLOBAL=/dev/null
    GIT_CONFIG_NOSYSTEM=1
  )

  echo $'\e[2;3m'"running git with: ${(j: :)kvs}"$'\e[0m' >&2
  env "${kvs[@]}" git "$@"
}

