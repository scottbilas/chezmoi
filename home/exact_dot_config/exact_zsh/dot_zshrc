# fzf. fasd, etc.

set-shell-theme() {
  local -r theme="$1"

  local cfg="$(chezmoi execute-template '{{ .chezmoi.configFile }}')"
  yq e -i ".data.profile.theme = \"$theme\"" "$cfg"

  chezmoi apply ~/.config/bat/bat.conf
  chezmoi apply ~/.config/eza/theme.yml
  chezmoi apply ~/.config/lazygit/config.yml
  chezmoi apply ~/.config/micro/settings.json
  chezmoi apply ~/.config/starship.toml
  chezmoi apply ~/.gemini/settings.json

  if (( $+commands[fast-theme] )); then
    if [[ "$theme" == "dark" ]]; then
      fast-theme free
    else
      fast-theme base16
    fi
  fi
}

if is-macos; then
  set-lightmode() { osascript -e 'tell application "System Events" to tell appearance preferences to set dark mode to false' && set-shell-theme light; }
  set-darkmode() { osascript -e 'tell application "System Events" to tell appearance preferences to set dark mode to true' && set-shell-theme dark; }
  
  is-darkmode() {
    local cur
    cur=$(osascript -e 'tell application "System Events" to tell appearance preferences to get dark mode' 2>/dev/null) || cur=''
    [[ "$cur" == "true" ]]
  }

  # these things hang a lot
  kill-parallels-vms()  {
    ps aux | grep prl_vm | grep -v grep | awk '{print $2}' | xargs sudo kill -9
  }
fi

is-lightmode() {
  ! is-darkmode
}

toggle-lightdarkmode() {
  if is-darkmode; then
    set-lightmode
  else
    set-darkmode
  fi
}

#### LAST

# keep these last so they override any modules

## OPTIONS

setopt auto_pushd
setopt globdots # include dotfiles in tab completion and other globbing (i don't care they are "hidden")

## history-related

mkdir -p ~/.local/share/zsh
HISTFILE=~/.local/share/zsh/history
HISTSIZE=5000  # memory buffer max size in lines
SAVEHIST=5000   # file max size in lines
setopt append_history          # append to history file instead of overwrite
setopt share_history           # share command history data across terminals
setopt bang_hist               # https://linuxhint.com/search-in-my-zsh-history/
setopt hist_ignore_all_dups    # don't want any dups in history at all
setopt hist_ignore_space       # leading space will prevent adding the command to history

# map up/down arrow to partial history-based match, while also supporting cursoring
# within a multiline command.
autoload up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

# mac-only, cmd-backspace
bindkey "^[[3~" delete-char


## line editing

# ctrl left/right to move word left/right
bindkey '^[[1;5C' emacs-forward-word
bindkey '^[[1;5D' emacs-backward-word
# home and end
bindkey '^[[1~' beginning-of-line
bindkey '^[[4~' end-of-line
# undo/redo
bindkey '^Y' redo
bindkey '^Z' undo

## (un-)line editing

do-nothing() {}
zle -N do-nothing

# pageup/down ignore to prevent accidental crudding on fn lock laptop
bindkey '^[[5~' do-nothing
bindkey '^[[6~' do-nothing

