## darwin system upgrade

if is-macos; then
  nix-darwin-upgrade() {
    echo "🔄 Updating nix-darwin flake inputs..."
    nix flake update --flake ~/.config/nix-darwin || return 1
  
    echo "🔨 Rebuilding darwin system configuration..."
    sudo darwin-rebuild switch --flake ~/.config/nix-darwin || return 1
  
    echo "📦 Upgrading Homebrew packages..."
    brew upgrade || return 1
  
    echo "✅ All systems upgraded successfully!"
  }
fi

