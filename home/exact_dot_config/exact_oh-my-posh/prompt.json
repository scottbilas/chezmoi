{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "console_title_template": "{{if .Env.SHELL_TITLE}}{{.Env.SHELL_TITLE}} ❱ {{end}}{{.PWD}} :: {{.Shell}}",
  "final_space": true,
  "version": 3,

  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "template": "{{.Icon}} ",
          "foreground": "#26C6DA",
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "session",
          "style": "plain",
          "template": "{{ if .SSHSession }}\ueb39 {{ end }}{{ .HostName }}",
          "foreground": "#26C6DA",
          "properties": {
            "cache_duration": "none",
            "display_user": false
          }
        },
        {
          "type": "root",
          "style": "diamond",
          "leading_diamond": " \ue0b6", // 
          "trailing_diamond": "\ue0b4 ", // 
          "foreground": "white",
          "background": "#ff0000",
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "path",
          "style": "powerline",
          "template": " {{ .Path }} ",
          "powerline_symbol": "\ue0b0",
          "foreground": "#ffffff",
          "background": "#99295d",
          "properties": {
            "cache_duration": "none",
            "folder_separator_icon": "/",
            "style": "full"
          }
        },
        {
          "type": "unity",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#111111",
          "background": "#ffffff",
          "properties": {
            "cache_duration": "none",
            "http_timeout": 2000
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "template": "{{ .UpstreamIcon }} {{ .HEAD }}{{ .BranchStatus }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Staging.Changed) (.Working.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0}} \uf51e {{ .StashCount }}{{ end }}{{ if gt .WorktreeCount 0}} \uf1bb {{ .WorktreeCount }}{{ end }}",
          "powerline_symbol": "\ue0b0",
          "foreground": "#193549",
          "background": "#b87b2a",
          "properties": {
            "branch_icon": "\ue725 ", // 
            "cache_duration": "none",
            "fetch_stash_count": true,
            "fetch_upstream_icon": true,
            "fetch_worktree_count": true,
            "git_icon": "\uf1d3", //   << default when upstream_icons does not match on url
            "tag_icon": "\uf412 ",
            "upstream_icons": {
              "github.cds": "\ue721", // 
              "github.com": "\uf09b" // 
            }
          }
        },
        {
          "type": "plastic",
          "style": "powerline",
          "template": " \ue24f \ue725 ",
          "background_templates": [
            "{{ if .MergePending }}#006060{{ end }}",
            "{{ if .Changed }}#FF9248{{ end }}",
            "{{ if and .Changed .Behind }}#ff4500{{ end }}",
            "{{ if .Behind }}#B388FF{{ end }}"
          ],
          "powerline_symbol": "\ue0b0",
          "foreground": "#193549",
          "background": "#e65404",
          "properties": {
            //"fetch_status": true, // crazy slow, cannot use this without caching of some kind
            "branch_max_length": 25,
            "cache_duration": "none",
            "truncate_symbol": "\u2026"
          }
        },
        {
          "type": "status",
          "style": "plain",
          "template": " \uf00d {{ .Code }}{{ if not (and (ge (index .Meaning 0) 48) (le (index .Meaning 0) 57)) }} ({{ .Meaning }}){{ end }}",
          "leading_diamond": " \ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground_templates": [
            "{{ if eq .Code 2 }}#f0ac00{{ else }}#ff0000{{ end }}"
          ],
          "background": "black",
          "properties": {
            "cache_duration": "none"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "diamond",
          "template": " <#fefefe>\uf4e3</> {{ .FormattedMs }} ",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "powerline_symbol": "\ue0b0",
          "foreground": "#ffffff",
          "background": "#8800dd",
          "properties": {
            "cache_duration": "none",
            "threshold": 1500
          }
        },
        {
          "type": "time",
          "style": "plain",
          "template": " {{ .CurrentDate | date .Format }}",
          "foreground": "#007ACC",
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "battery",
          "style": "plain",
          "template": " {{ if and (not .Error) (lt .Percentage 99) }}{{ .Icon }}{{ .Percentage }}\uf295{{ end }}",
          "foreground_templates": [
            "{{if eq \"Charging\" .State.String}}#40c4ff{{end}}",
            "{{if and (eq \"Discharging\" .State.String) (ne 100 .Percentage)}}#ff5722{{end}}",
            "{{if eq \"Full\" .State.String}}#4caf50{{end}}",
            "#4caf50"
          ],
          "properties": {
            "cache_duration": "none",
            "charged_icon": "\ue22f ",
            "charging_icon": "\ue234 ",
            "discharging_icon": "\u21e3 "
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "template": "$",
          "properties": {
            "cache_duration": "none"
          }
        }
      ]
    }
  ]
}
